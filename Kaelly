        "jsCode": "const b=$input.first().json.body ?? $input.first().json;\nconst message=String(b.message ?? '').trim();\nif(!message) throw new Error('Send JSON with sender, subject, and message.');\nconst knowledgeBase=[\n{id:'KB01',topic:'Assignments',keywords:['assignment','homework','submit'],answer:'Assignments are submitted through the course portal.'},\n{id:'KB02',topic:'Due dates',keywords:['due date','deadline','calendar'],answer:'Due dates are listed in the course calendar and assignment page.'},\n{id:'KB03',topic:'Grades',keywords:['grade','score','points'],answer:'Grades can be checked in the Grades section of the course portal.'},\n{id:'KB04',topic:'Late work',keywords:['late','missed','past due'],answer:'Contact the instructor about late work and applicable course policy.'},\n{id:'KB05',topic:'Extensions',keywords:['extension','extra time','extend'],answer:'Send extension requests directly to the instructor.'},\n{id:'KB06',topic:'Course materials',keywords:['slides','notes','materials','module'],answer:'Course materials are available in the relevant course modules.'},\n{id:'KB07',topic:'Attendance',keywords:['attendance','absent','absence'],answer:'Attendance requirements are described in the course syllabus.'},\n{id:'KB08',topic:'Office hours',keywords:['office hours','appointment'],answer:'Check the syllabus or course page for office hours.'},\n{id:'KB09',topic:'Login problems',keywords:['login','password','sign in'],answer:'Try the password-reset option or contact campus IT support.'},\n{id:'KB10',topic:'Technical issues',keywords:['error','portal not working','upload failed','technical'],answer:'Contact technical support and inform your instructor if a submission is affected.'}\n];\nconst sender=String(b.sender ?? 'unknown'), subject=String(b.subject ?? b.topic ?? 'No subject');\nconst text=(subject+' '+message).toLowerCase();\nconst matchedKnowledge=knowledgeBase.filter(x=>x.keywords.some(k=>text.includes(k)));\nreturn [{json:{sender,subject,message,receivedAt:new Date().toISOString(),knowledgeBase,matchedKnowledge}}];"
      },
