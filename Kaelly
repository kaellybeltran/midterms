    {
      "parameters": {
        "jsCode": "const c=$('Prepare Message + Search Knowledge Base').first().json;\nlet v=$input.first().json.output?.[0]?.content?.[0]?.text ?? {}; if(typeof v==='string'){try{v=JSON.parse(v)}catch(e){v={}}}\nconst allowed=['Course question','Grade inquiry','Deadline extension','Technical issue','General inquiry'];\nif(!allowed.includes(v.category)) v.category='General inquiry';\nreturn [{json:{...c,classification:{category:v.category,confidence:Math.max(0,Math.min(1,Number(v.confidence)||0)),reasoning:String(v.reasoning??'')}}}];"
